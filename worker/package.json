{
  "name": "frontping-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "dev": "wrangler dev",
    "tail": "wrangler tail",
    "config:gen": "node scripts/gen-config.mjs",
    "deploy": "pnpm config:gen && wrangler deploy --config wrangler.generated.toml",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "token:issue": "node scripts/issue-token.mjs",
    "migrate:local": "wrangler d1 migrations apply frontping --local",
    "migrate:remote": "pnpm config:gen && wrangler d1 migrations apply frontping --remote --config wrangler.generated.toml"
  },
  "dependencies": {
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.5.0",
    "@cloudflare/workers-types": "^4.20260101.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "wrangler": "^4.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "workerd", "sharp"]
  }
}
